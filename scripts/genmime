MIME_ENUM_FILE=include/crankshaft/mimeenum.h
MIME_VALUE_FILE=include/crankshaft/mimevalues.h
echo "//autogenerated by scripts/genmime" > $MIME_ENUM_FILE
echo "enum CS_MIMETypes {" >> $MIME_ENUM_FILE
echo "    CS_MIME_DO_NOT_SET = -1," >> $MIME_ENUM_FILE
echo "//autogenerated by scripts/genmime" > $MIME_VALUE_FILE
echo "static struct ExtensionToMIME extensions[] = {" >> $MIME_VALUE_FILE

for LINE in `cat mimedata/mimedata.csv`; do
    ENUM=$(echo $LINE|cut -f 1 -d ,)
    EXT=$(echo $LINE|cut -f 2 -d ,)
    VAL=$(echo $LINE|cut -f 3 -d ,)
    echo "    $ENUM," >> $MIME_ENUM_FILE
    echo "    {\"$EXT\",\"$VAL\"}," >> $MIME_VALUE_FILE
done

echo "    MAX_CS_MIME_TYPES" >> $MIME_ENUM_FILE
echo "};" >> $MIME_ENUM_FILE
echo "};" >> $MIME_VALUE_FILE
